---
import type { UiLocale } from '../data/ui';

interface Props {
	locale: UiLocale;
	active?: 'home' | 'downloads' | 'tutorials';
}

const { locale, active } = Astro.props;
const prefix = locale === 'en' ? '' : `/${locale}`;
const homeHref = prefix || '/';
const downloadsHref = `${prefix}/downloads/`;
const tutorialsHref = `${prefix}/tutorials/`;

const nav = {
	en: { studio: 'Studio', tutorials: 'Tutorials', downloads: 'Downloads' },
	'zh-cn': { studio: 'Studio', tutorials: '教程', downloads: '下载' },
	ja: { studio: 'Studio', tutorials: 'チュートリアル', downloads: 'ダウンロード' },
	es: { studio: 'Studio', tutorials: 'Tutoriales', downloads: 'Descargas' },
}[locale];

const locales: { id: UiLocale; label: string; href: string }[] = [
	{ id: 'en', label: 'English', href: active === 'downloads' ? '/downloads/' : '/' },
	{
		id: 'zh-cn',
		label: '简体中文',
		href: active === 'downloads' ? '/zh-cn/downloads/' : '/zh-cn/',
	},
	{ id: 'ja', label: '日本語', href: active === 'downloads' ? '/ja/downloads/' : '/ja/' },
	{ id: 'es', label: 'Español', href: active === 'downloads' ? '/es/downloads/' : '/es/' },
];
---

<header class="mkt-header">
	<a class="mkt-brand" href={homeHref}>
		<span class="brand-dot" aria-hidden="true"></span>
		<span>StmPy Studio</span>
	</a>
	<nav class="mkt-nav" aria-label="Primary">
		<a class:list={[{ 'is-active': active === 'home' }]} href={homeHref}>{nav.studio}</a>
		<a class:list={[{ 'is-active': active === 'tutorials' }]} href={tutorialsHref}>{nav.tutorials}</a>
		<a class:list={[{ 'is-active': active === 'downloads' }]} href={downloadsHref}>{nav.downloads}</a>
	</nav>
	<div class="mkt-tools">
		<a
			class="mkt-github"
			href="https://github.com/stmpy-org/stmpy-studio"
			rel="noopener noreferrer"
			aria-label="GitHub"
		>
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
				><path
					fill="currentColor"
					d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"
				></path></svg
			>
		</a>
		<label class="mkt-select">
			<span class="sr-only">Theme</span>
			<select data-theme-select>
				<option value="dark">Dark</option>
				<option value="light">Light</option>
				<option value="auto">Auto</option>
			</select>
		</label>
		<label class="mkt-select">
			<span class="sr-only">Language</span>
			<select data-lang-select onchange="location.href=this.value">
				{
					locales.map((l) => (
						<option value={l.href} selected={l.id === locale}>
							{l.label}
						</option>
					))
				}
			</select>
		</label>
	</div>
</header>

<script is:inline>
	(function () {
		var key = 'starlight-theme';
		var root = document.documentElement;
		function apply(v) {
			var theme = v === 'auto' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : v;
			root.dataset.theme = theme === 'light' ? 'light' : 'dark';
		}
		try {
			if (!localStorage.getItem(key)) localStorage.setItem(key, 'dark');
			var stored = localStorage.getItem(key) || 'dark';
			apply(stored);
			document.querySelectorAll('[data-theme-select]').forEach(function (sel) {
				sel.value = stored;
				sel.addEventListener('change', function () {
					localStorage.setItem(key, sel.value);
					apply(sel.value);
				});
			});
		} catch (e) {
			root.dataset.theme = 'dark';
		}
	})();
</script>

<style>
	.mkt-header {
		display: flex;
		align-items: center;
		gap: var(--space-lg);
		height: 64px;
		padding: 0 var(--space-lg);
		background: var(--color-canvas);
		color: var(--color-on-primary);
		position: sticky;
		top: 0;
		z-index: 20;
	}
	:global(:root[data-theme='light']) .mkt-header {
		background: var(--color-canvas-light);
		color: var(--color-ink);
		border-bottom: 1px solid var(--color-hairline);
	}
	.mkt-brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		color: inherit;
		text-decoration: none;
		font-weight: 500;
		font-size: var(--type-body);
		letter-spacing: -0.01em;
		flex-shrink: 0;
	}
	.mkt-nav {
		display: none;
		gap: var(--space-md);
		margin-inline: auto;
	}
	@media (min-width: 720px) {
		.mkt-nav {
			display: flex;
		}
	}
	.mkt-nav a {
		color: inherit;
		text-decoration: none;
		font-size: var(--type-body);
		font-weight: 500;
		opacity: 0.75;
		padding: var(--space-xs) 0;
	}
	.mkt-nav a:hover,
	.mkt-nav a.is-active {
		opacity: 1;
	}
	.mkt-tools {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		margin-inline-start: auto;
	}
	.mkt-github {
		color: inherit;
		display: flex;
		opacity: 0.85;
	}
	.mkt-select select {
		appearance: none;
		background: transparent;
		border: 1px solid var(--color-hairline-soft);
		border-radius: var(--radius-app-md);
		color: inherit;
		font: inherit;
		font-size: var(--type-caption);
		padding: 4px 8px;
		height: 32px;
	}
	:global(:root[data-theme='light']) .mkt-select select {
		border-color: var(--color-hairline);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		border: 0;
	}
</style>
