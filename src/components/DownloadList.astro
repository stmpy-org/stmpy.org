---
import { DOWNLOAD_BASE_URL } from '../data/config';
import latest from '../data/downloads/latest.json';
import manifest002 from '../data/downloads/0.0.2.json';
import { normalizeLocale, ui } from '../data/ui';

type Asset = {
	id: string;
	platform: string;
	os: string;
	ext: string;
	filename: string;
	label: Record<string, string>;
};

type Manifest = {
	version: string;
	bundledStmpy?: string;
	notesUrl?: string;
	assets: Asset[];
	installHints?: Record<string, Record<string, string>>;
};

const locale = normalizeLocale(Astro.props.locale ?? Astro.currentLocale);
const t = ui(locale);

const catalog: Record<string, Manifest> = {
	'0.0.2': manifest002 as Manifest,
};
const manifest = catalog[latest.version];
if (!manifest) {
	throw new Error(`missing manifest for version ${latest.version}`);
}

function assetUrl(filename: string) {
	return `${DOWNLOAD_BASE_URL}/${manifest.version}/${filename}`;
}

function labelFor(asset: Asset) {
	return asset.label[locale] ?? asset.label.en ?? asset.filename;
}

function hint(key: string) {
	const block = manifest.installHints?.[key];
	if (!block) return null;
	return block[locale] ?? block.en ?? null;
}

const macosHint = hint('macos');
const linuxHint = hint('linux-appimage');
---

<section class="dl">
	<header class="dl__head">
		<p class="dl__eyebrow">STMPY STUDIO</p>
		<h1>{t.downloadHeading}</h1>
		<p class="dl__lead">{t.downloadLead}</p>
		<p class="dl__meta">
			<span>{t.versionLabel}: <strong>{manifest.version}</strong></span>
			{
				manifest.bundledStmpy && (
					<span>
						{t.bundledLabel}: <strong>{manifest.bundledStmpy}</strong>
					</span>
				)
			}
			{
				manifest.notesUrl && (
					<a href={manifest.notesUrl} rel="noopener noreferrer">
						{t.releaseNotes}
					</a>
				)
			}
		</p>
		<p class="dl__note">{t.placeholderNote}</p>
	</header>

	<ul class="dl__list">
		{
			manifest.assets.map((asset, i) => (
				<li>
					<a class:list={['dl__btn', i === 0 && 'dl__btn--primary']} href={assetUrl(asset.filename)}>
						<span class="dl__label">{labelFor(asset)}</span>
						<code class="dl__file">{asset.filename}</code>
					</a>
				</li>
			))
		}
	</ul>

	{
		macosHint && (
			<aside class="dl__hint">
				<strong>{t.macosHintTitle}</strong>
				<p>{macosHint}</p>
			</aside>
		)
	}
	{
		linuxHint && (
			<aside class="dl__hint">
				<strong>{t.linuxHintTitle}</strong>
				<p>{linuxHint}</p>
			</aside>
		)
	}
</section>

<style>
	.dl {
		display: grid;
		gap: var(--space-xl);
		max-width: 40rem;
	}
	.dl__eyebrow {
		font-family: var(--font-mono);
		font-size: var(--type-mono-eyebrow);
		color: var(--color-mute);
		margin: 0 0 var(--space-sm);
		letter-spacing: 0.02em;
	}
	.dl__head h1 {
		font-size: clamp(2rem, 5vw, var(--type-display-sm));
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin: 0 0 var(--space-sm);
		color: var(--sl-color-white);
	}
	.dl__lead {
		margin: 0;
		font-size: var(--type-subtitle);
		line-height: 1.5;
		letter-spacing: -0.01em;
		color: var(--color-ash);
	}
	:global(:root[data-theme='light']) .dl__lead {
		color: var(--color-slate);
	}
	.dl__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm) var(--space-lg);
		font-size: var(--type-caption);
		margin: var(--space-md) 0 0;
		color: var(--color-mute);
	}
	.dl__meta a {
		color: var(--sl-color-text-accent);
	}
	.dl__meta strong {
		color: var(--sl-color-white);
		font-weight: 500;
	}
	.dl__note {
		font-size: var(--type-meta);
		color: var(--color-mute);
		margin: var(--space-sm) 0 0;
	}
	.dl__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-sm);
	}
	.dl__btn {
		display: grid;
		gap: var(--space-xxs);
		padding: var(--space-md) var(--space-lg);
		border: 1px solid var(--color-hairline-soft);
		border-radius: var(--radius-marketing);
		text-decoration: none;
		color: inherit;
		background: var(--color-canvas-soft);
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	:global(:root[data-theme='light']) .dl__btn {
		background: var(--color-canvas-light);
		border-color: var(--color-hairline);
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
	}
	.dl__btn:hover {
		border-color: var(--color-ash);
	}
	.dl__btn--primary {
		background: var(--color-brand);
		border-color: transparent;
		color: var(--color-ink);
	}
	.dl__btn--primary:hover {
		border-color: transparent;
		filter: brightness(1.04);
	}
	.dl__btn--primary .dl__label {
		color: var(--color-ink);
	}
	.dl__btn--primary .dl__file {
		color: var(--color-ink-soft);
		background: transparent;
		opacity: 0.9;
	}
	.dl__label {
		font-size: var(--type-body);
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.dl__file {
		font-family: var(--font-mono);
		font-size: var(--type-mono-micro);
		color: var(--color-mute);
		background: transparent;
		padding: 0;
		border-radius: 0;
	}
	.dl__hint {
		padding: var(--space-md);
		border-radius: var(--radius-app-lg);
		background: var(--color-surface-blue-bg);
		color: var(--color-ink);
	}
	.dl__hint strong {
		font-size: var(--type-caption-tight, 13px);
		font-weight: 500;
	}
	.dl__hint p {
		margin: var(--space-xxs) 0 0;
		font-size: var(--type-body-sm);
		line-height: 1.5;
	}
</style>
