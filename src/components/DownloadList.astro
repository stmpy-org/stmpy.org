---
import { DOWNLOAD_BASE_URL } from '../data/config';
import latest from '../data/downloads/latest.json';
import manifest002 from '../data/downloads/0.0.2.json';
import { normalizeLocale, ui } from '../data/ui';

type Asset = {
	id: string;
	platform: string;
	os: string;
	ext: string;
	filename: string;
	label: Record<string, string>;
};

type Manifest = {
	version: string;
	bundledStmpy?: string;
	notesUrl?: string;
	assets: Asset[];
	installHints?: Record<string, Record<string, string>>;
};

type FormatOption = {
	formatLabel: string;
	href: string;
};

const locale = normalizeLocale(Astro.props.locale ?? Astro.currentLocale);
const t = ui(locale);

const catalog: Record<string, Manifest> = {
	'0.0.2': manifest002 as Manifest,
};
const manifest = catalog[latest.version];
if (!manifest) {
	throw new Error(`missing manifest for version ${latest.version}`);
}

function assetUrl(filename: string) {
	return `${DOWNLOAD_BASE_URL}/${manifest.version}/${filename}`;
}

const downloadWord = {
	en: 'Download',
	'zh-cn': '下载',
	ja: 'ダウンロード',
	es: 'Descargar',
}[locale];

function macosFormats(assets: Asset[]): FormatOption[] {
	return assets.map((a) => ({
		formatLabel: '.dmg (Apple Silicon)',
		href: assetUrl(a.filename),
	}));
}

function windowsFormats(assets: Asset[]): FormatOption[] {
	return assets.map((a) => ({
		formatLabel: '.exe (x64)',
		href: assetUrl(a.filename),
	}));
}

function linuxFormats(assets: Asset[]): FormatOption[] {
	const order = ['.deb', '.AppImage'];
	return order
		.map((ext) => assets.find((a) => a.ext === ext))
		.filter((a): a is Asset => !!a)
		.map((a) => ({
			formatLabel: a.ext === '.AppImage' ? '.AppImage' : '.deb',
			href: assetUrl(a.filename),
		}));
}

const platforms = [
	{
		id: 'macos',
		name: 'macOS',
		icon: '/download/003-apple-logo.png',
		iconClass: 'dl-card__icon--apple',
		formats: macosFormats(manifest.assets.filter((a) => a.os === 'macos')),
	},
	{
		id: 'windows',
		name: 'Windows',
		icon: '/download/001-windows.png',
		iconClass: '',
		formats: windowsFormats(manifest.assets.filter((a) => a.os === 'windows')),
	},
	{
		id: 'linux',
		name: 'Linux',
		icon: '/download/002-linux.png',
		iconClass: '',
		formats: linuxFormats(manifest.assets.filter((a) => a.os === 'linux')),
	},
] as const;

const chooseFormatLabel = {
	en: 'Choose format',
	'zh-cn': '选择格式',
	ja: '形式を選択',
	es: 'Elegir formato',
}[locale];
---

<section class="dl">
	<header class="dl__head">
		<p class="dl__eyebrow">STMPY STUDIO</p>
		<h1>{t.downloadHeading}</h1>
		<p class="dl__lead">{t.downloadLead}</p>
		<p class="dl__meta">
			<span>{t.versionLabel}: <strong>{manifest.version}</strong></span>
			{
				manifest.bundledStmpy && (
					<span>
						{t.bundledLabel}: <strong>{manifest.bundledStmpy}</strong>
					</span>
				)
			}
			{
				manifest.notesUrl && (
					<a href={manifest.notesUrl} rel="noopener noreferrer">
						{t.releaseNotes}
					</a>
				)
			}
		</p>
		<p class="dl__note">{t.placeholderNote}</p>
	</header>

	<ul class="dl-cards">
		{
			platforms.map((p) => {
				const initial = p.formats[0];
				const multi = p.formats.length > 1;
				return (
					<li class="dl-card">
						<img
							class:list={['dl-card__icon', p.iconClass]}
							src={p.icon}
							alt=""
							width="64"
							height="64"
							decoding="async"
						/>
						<h2 class="dl-card__name">{p.name}</h2>
						<div class="dl-card__actions">
							{initial && (
								<div class="dl-split" data-dl-split={multi ? '' : undefined}>
									<a class="dl-split__go" href={initial.href} data-dl-go>
										{downloadWord}
									</a>
									<span class="dl-split__sep" aria-hidden="true" />
									{multi ? (
										<div class="dl-split__picker">
											<button
												type="button"
												class="dl-split__fmt"
												aria-haspopup="listbox"
												aria-expanded="false"
												aria-label={chooseFormatLabel}
												data-dl-toggle
											>
												<span data-dl-label>{initial.formatLabel}</span>
												<svg
													class="dl-split__chev"
													viewBox="0 0 12 12"
													width="12"
													height="12"
													aria-hidden="true"
												>
													<path
														d="M2.5 4.5 6 8l3.5-3.5"
														fill="none"
														stroke="currentColor"
														stroke-width="1.5"
														stroke-linecap="round"
														stroke-linejoin="round"
													/>
												</svg>
											</button>
											<ul class="dl-split__menu" role="listbox" hidden data-dl-menu>
												{p.formats.map((opt, i) => (
													<li role="presentation">
														<button
															type="button"
															role="option"
															class="dl-split__option"
															aria-selected={i === 0 ? 'true' : 'false'}
															data-href={opt.href}
															data-label={opt.formatLabel}
														>
															{opt.formatLabel}
														</button>
													</li>
												))}
											</ul>
										</div>
									) : (
										<span class="dl-split__fmt dl-split__fmt--static">{initial.formatLabel}</span>
									)}
								</div>
							)}
						</div>
					</li>
				);
			})
		}
	</ul>
</section>

<script>
	function closeAll(except?: HTMLElement) {
		document.querySelectorAll('[data-dl-split]').forEach((root) => {
			if (except && root === except) return;
			const menu = root.querySelector('[data-dl-menu]');
			const toggle = root.querySelector('[data-dl-toggle]');
			if (menu) menu.hidden = true;
			if (toggle) toggle.setAttribute('aria-expanded', 'false');
		});
	}

	document.querySelectorAll('[data-dl-split]').forEach((root) => {
		const go = root.querySelector('[data-dl-go]');
		const toggle = root.querySelector('[data-dl-toggle]');
		const menu = root.querySelector('[data-dl-menu]');
		const label = root.querySelector('[data-dl-label]');
		if (!go || !toggle || !menu || !label) return;

		toggle.addEventListener('click', (e) => {
			e.preventDefault();
			e.stopPropagation();
			const open = menu.hidden;
			closeAll();
			if (open) {
				menu.hidden = false;
				toggle.setAttribute('aria-expanded', 'true');
				const selected = menu.querySelector('[aria-selected="true"]');
				(selected || menu.querySelector('[role="option"]'))?.focus();
			}
		});

		menu.querySelectorAll('[role="option"]').forEach((opt) => {
			opt.addEventListener('click', (e) => {
				e.preventDefault();
				const href = opt.getAttribute('data-href');
				const text = opt.getAttribute('data-label');
				if (href) go.setAttribute('href', href);
				if (text) label.textContent = text;
				menu.querySelectorAll('[role="option"]').forEach((o) => o.setAttribute('aria-selected', 'false'));
				opt.setAttribute('aria-selected', 'true');
				menu.hidden = true;
				toggle.setAttribute('aria-expanded', 'false');
				toggle.focus();
			});
		});

		toggle.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				if (menu.hidden) toggle.click();
			} else if (e.key === 'Escape') {
				menu.hidden = true;
				toggle.setAttribute('aria-expanded', 'false');
			}
		});

		menu.addEventListener('keydown', (e) => {
			const options = [...menu.querySelectorAll('[role="option"]')];
			const i = options.indexOf(document.activeElement);
			if (e.key === 'Escape') {
				e.preventDefault();
				menu.hidden = true;
				toggle.setAttribute('aria-expanded', 'false');
				toggle.focus();
			} else if (e.key === 'ArrowDown') {
				e.preventDefault();
				options[(i + 1) % options.length]?.focus();
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				options[(i - 1 + options.length) % options.length]?.focus();
			} else if (e.key === 'Home') {
				e.preventDefault();
				options[0]?.focus();
			} else if (e.key === 'End') {
				e.preventDefault();
				options[options.length - 1]?.focus();
			}
		});
	});

	document.addEventListener('click', () => closeAll());
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeAll();
	});
</script>

<style>
	.dl {
		display: grid;
		gap: var(--space-xxl);
	}
	.dl__eyebrow {
		font-family: var(--font-mono);
		font-size: var(--type-mono-eyebrow);
		color: var(--color-mute);
		margin: 0 0 var(--space-sm);
		letter-spacing: 0.02em;
	}
	.dl__head h1 {
		font-size: clamp(2rem, 5vw, var(--type-display-sm));
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin: 0 0 var(--space-sm);
		color: var(--sl-color-white);
	}
	.dl__lead {
		margin: 0;
		font-size: var(--type-subtitle);
		line-height: 1.5;
		letter-spacing: -0.01em;
		color: var(--color-ash);
		max-width: 40rem;
	}
	:global(:root[data-theme='light']) .dl__lead {
		color: var(--color-slate);
	}
	.dl__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm) var(--space-lg);
		font-size: var(--type-caption);
		margin: var(--space-md) 0 0;
		color: var(--color-mute);
	}
	.dl__meta a {
		color: var(--sl-color-text-accent);
	}
	.dl__meta strong {
		color: var(--sl-color-white);
		font-weight: 500;
	}
	.dl__note {
		font-size: var(--type-meta);
		color: var(--color-mute);
		margin: var(--space-sm) 0 0;
	}

	.dl-cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-lg);
		grid-template-columns: 1fr;
	}
	@media (min-width: 800px) {
		.dl-cards {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.dl-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-sm);
		padding: var(--space-xl) var(--space-lg);
		border: 1px solid var(--color-hairline-soft);
		border-radius: var(--radius-marketing);
		background: var(--color-canvas-soft);
		min-height: 100%;
		box-sizing: border-box;
	}
	:global(:root[data-theme='light']) .dl-card {
		background: var(--color-canvas-light);
		border-color: var(--color-hairline);
	}
	.dl-card__icon {
		width: 64px;
		height: 64px;
		object-fit: contain;
		display: block;
		margin-bottom: var(--space-xs);
	}
	:global(:root[data-theme='dark']) .dl-card__icon--apple,
	:global(:root:not([data-theme='light'])) .dl-card__icon--apple {
		filter: invert(1);
	}
	.dl-card__name {
		margin: 0;
		font-size: var(--type-heading-sm);
		font-weight: 500;
		letter-spacing: -0.02em;
	}
	.dl-card__actions {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: 100%;
		margin-top: var(--space-md);
	}

	/* Dark split pill — readable on both themes */
	.dl-split {
		position: relative;
		display: flex;
		align-items: stretch;
		width: 100%;
		min-height: 40px;
		border-radius: var(--radius-full);
		background: var(--color-ink);
		color: var(--color-on-primary);
		overflow: visible;
	}
	.dl-split__go {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		padding: 0 var(--space-md);
		color: inherit;
		text-decoration: none;
		font-weight: 500;
		font-size: var(--type-body);
		line-height: 1;
		white-space: nowrap;
		border-radius: var(--radius-full) 0 0 var(--radius-full);
	}
	.dl-split__go:hover,
	.dl-split__go:focus-visible {
		background: rgba(255, 255, 255, 0.08);
		outline: none;
	}
	.dl-split__sep {
		width: 1px;
		align-self: stretch;
		margin: 8px 0;
		background: rgba(255, 255, 255, 0.35);
		flex-shrink: 0;
	}
	.dl-split__picker {
		position: relative;
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
	}
	.dl-split__fmt {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		flex: 1 1 auto;
		min-width: 0;
		padding: 0 var(--space-md);
		border: none;
		background: transparent;
		color: inherit;
		font: inherit;
		font-weight: 500;
		font-size: var(--type-caption);
		line-height: 1.2;
		cursor: pointer;
		border-radius: 0 var(--radius-full) var(--radius-full) 0;
		white-space: nowrap;
	}
	.dl-split__fmt--static {
		cursor: default;
		pointer-events: none;
	}
	button.dl-split__fmt:hover,
	button.dl-split__fmt:focus-visible {
		background: rgba(255, 255, 255, 0.08);
		outline: none;
	}
	.dl-split__chev {
		flex-shrink: 0;
		opacity: 0.9;
	}
	.dl-split__menu {
		position: absolute;
		top: calc(100% + 6px);
		right: 0;
		left: 0;
		z-index: 5;
		margin: 0;
		padding: 6px;
		list-style: none;
		border-radius: var(--radius-app-lg);
		background: var(--color-ink);
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
		text-align: left;
	}
	.dl-split__option {
		display: block;
		width: 100%;
		padding: 8px 10px;
		border: none;
		border-radius: var(--radius-app-md);
		background: transparent;
		color: var(--color-on-primary);
		font: inherit;
		font-size: var(--type-caption);
		text-align: left;
		cursor: pointer;
	}
	.dl-split__option:hover,
	.dl-split__option:focus-visible,
	.dl-split__option[aria-selected='true'] {
		background: rgba(255, 255, 255, 0.1);
		outline: none;
	}
</style>
